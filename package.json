{
  "name": "shark-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend:setup": "uv sync --project backend --locked && cargo build --bin shark-backend",
    "backend:dev": "uv run --project backend --no-sync shark-runtime --workspace .",
    "backend:test": "uv run --project backend --no-sync python -m unittest discover -s backend/tests -v",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@google/genai": "^2.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.57.0",
    "openai": "^7.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
